# 1. DISABLE DIRECTORY LISTING
# If someone types ".../assets/", they won't see a list of your files.
Options -Indexes

# 2. HIDE PHP EXTENSION (Added)
# Turn on the rewriting engine
RewriteEngine On

# A. Redirect external requests for .php to the clean URL (Visual fix)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# B. Internally handle the request by pointing clean URL to .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

# 3. PROTECT SENSITIVE FILES
# Block access to crucial config files
<FilesMatch "config.php|db.php|db_connect.php">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. BLOCK ACCESS TO HIDDEN FILES
# Block access to .git, .env, or other system files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 5. PREVENT FILE SPYING
# Block access to error logs which might contain sensitive info
<Files error_log>
    Order allow,deny
    Deny from all
</Files>